# Swaloop — gerekli ortam değişkenleri
#
# Bu iki değer olmadan uygulama hiç açılmaz: src/lib/supabase.ts, eksik
# değişken bulduğunda açılışta doğrudan hata fırlatır.
#
# Değerleri Supabase panelinden alabilirsiniz:
#   Project Settings → API → Project URL ve Publishable (anon) key
#
# Bu dosyayı `.env.local` olarak kopyalayıp kendi değerlerinizi yazın.
# `.env*` dosyaları .gitignore'da: gerçek anahtarlar repoya girmez.

# Supabase projesinin API adresi.
VITE_SUPABASE_URL="https://<proje-id>.supabase.co"

# Supabase publishable (anon) anahtarı.
# Bu anahtar tarayıcıya iner ve herkese açıktır — güvenlik, anahtarın gizli
# kalmasıyla değil, veritabanındaki RLS politikalarıyla sağlanır
# (bkz. supabase/migrations/20260821090000_enable_rls_all_tables.sql).
# service_role anahtarını ASLA bu dosyaya veya istemci koduna koymayın.
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
